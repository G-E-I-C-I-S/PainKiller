# ----------------------------------------------------------------------------
coverage/
.nyc_output/
junit.xml
test-results/
playwright-report/
blob-report/
playwright/.cache/
# Maestro (E2E mobile)
.maestro/screenshots/
.maestro/recordings/

# ----------------------------------------------------------------------------
# Expo / React Native (apps/mobile)
# ----------------------------------------------------------------------------
.expo/
.expo-shared/
web-build/
expo-env.d.ts
