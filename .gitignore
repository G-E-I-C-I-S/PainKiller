# =============================================================================
# PainKiller — Guardião IFSULDEMINAS
# Monorepo: apps/mobile (Expo/React Native), apps/api (NestJS), apps/web (Vite)
# =============================================================================

# ----------------------------------------------------------------------------
# Segredos e variáveis de ambiente — NUNCA versionar
# (versione apenas os modelos .env.example)
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
!debug.keystore
*.mobileprovision
google-services.json
GoogleService-Info.plist
credentials.json
service-account*.json
# Chaves das tags NFC (SUN / NTAG 424 DNA) e arquivos de provisionamento
infra/scripts/**/chaves/
*.sunkeys
*.tagkeys.csv

# ----------------------------------------------------------------------------
# Dependências e gerenciador de pacotes
# ----------------------------------------------------------------------------
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/*
!.yarn/patches
!.yarn/releases

# ----------------------------------------------------------------------------
# Builds e caches
# ----------------------------------------------------------------------------
dist/
build/
out/
.turbo/
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.vite/
.parcel-cache/
storybook-static/

# ----------------------------------------------------------------------------
