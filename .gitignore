apps/mobile/android/
apps/mobile/ios/
# Artefatos de build
*.apk
*.aab
*.ipa
*.app
*.dSYM.zip
*.hprof
# Metro
.metro-health-check*
# Android
.gradle/
local.properties
captures/
.externalNativeBuild/
.cxx/
# iOS / Xcode
Pods/
xcuserdata/
DerivedData/
*.xcworkspace/xcuserdata/
*.xccheckout
# Bundles
*.jsbundle

# ----------------------------------------------------------------------------
# API (apps/api)
# ----------------------------------------------------------------------------
